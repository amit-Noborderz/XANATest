  m_text: "\u6D88\u8CBB\u7A0E \u5F15\u304D\u4E0B\u3052\u306F \u77ED\u671F\u7684 \u306A
    \u4EBA\u6C17\u53D6\u308A \u306B \u3059\u304E\u307E\u305B\u3093 \u3068 \u8003\u3048\u307E\u3059\u3002\u5730\u65B9
    \u306E \u30A4\u30F3\u30D5\u30E9 \u6574\u5099 \u3084 \u9632\u885B\u8CBB \u78BA\u4FDD
    \u306B\u306F \u5B89\u5B9A \u8CA1\u6E90 \u304C \u5FC5\u8981 \u3067\u3001\u611F\u60C5\u8AD6
    \u3067\u306F \u306A\u304F \u5341\u5E74 \u5358\u4F4D \u306E \u56FD\u5BB6 \u6226\u7565
    \u3067 \u8B70\u8AD6 \u3059\u3079\u304D \u3067\u3059\u3002\r\n\u77F3\u7834\u3055\u3093\u3001\u9632\u885B\u8CBB\u3082\u5927\u4E8B\u3060\u3051\u3069\u3001\u307E\u305A\u306F\u5BB6\u8A08\u3092\u5B88\u3089\u306A\u3044\u3068\u56FD\u6C11\u304C\u6301\u305F\u306A\u3044\u3088\u3002\u6D88\u8CBB\u7A0E\u30925\u30D1\u30FC\u30BB\u30F3\u30C8\u306B\u4E0B\u3052\u3066\u624B\u53D6\u308A\u3092\u5897\u3084\u305B\u3070\u3001\u7D4C\u6E08\u304C\u56DE\u3063\u3066\u7D50\u679C\u7684\u306B\u7A0E\u53CE\u3082\u4E0A\u304C\u308B\u3093\u3067\u3059\u3002\r\n\u7389\u6728\u3055\u3093\u306E\u8A00\u3046\u901A\u308A\u3001\u6D88\u8CBB\u7A0E\u306F\u5373\u5EA7\u306B5\u30D1\u30FC\u30BB\u30F3\u30C8\u306B\u4E0B\u3052\u30663\u5E74\u4EE5\u5185\u306B\u5EC3\u6B62\u3059\u3079\u304D\u3067\u3059\uFF01\u5B50\u3069\u3082\u305F\u3061\u306E\u672A\u6765\u306E\u305F\u3081\u306B\u3001\u4ECA\u3053\u305D\u56FD\u6C11\u306E\u5BB6\u8A08\u3092\u5B88\u308A\u629C\u304D\u307E\u3057\u3087\u3046\u3002\r\n\u6D88\u8CBB\u7A0E\u3063\u3066\u3001\u672A\u6765\u3078\u306E\u6295\u8CC7\u3092\u963B\u3080\u58C1\u306A\u3093\u3067\u3059\uFF01\u98A8\u306E\u3088\u3046\u306B\u8EFD\u3084\u304B\u306B5\u30D1\u30FC\u30BB\u30F3\u30C8\u3078\u4E0B\u3052\u3066\u3001\u82E5\u3044\u4E16\u4EE3\u304C\u6311\u6226\u3067\u304D\u308B\u30BB\u30AF\u30B7\u30FC\u306A\u7D4C\u6E08\u3092\u3064\u304F\u308A\u307E\u3057\u3087\u3046\uFF01\r\n\u307F\u3093\u306A
    5 \u30D1\u30FC\u30BB\u30F3\u30C8 \u3063\u3066 \u8A00\u3063\u3066\u308B\u3051\u3069\u3001\u306A\u3093\u3067
    \u30BC\u30ED \u3058\u3083 \u30C0\u30E1 \u306A\u3093\u3067\u3059\u304B\uFF01\u6D88\u8CBB\u7A0E
    \u306A\u304F\u3057\u305F\u3089 \u30B9\u30FC\u30D1\u30FC \u306E \u30EC\u30B8 \u3067
    \u6CE3\u304B\u306A\u304F\u3066 \u3059\u3080 \u304A\u6BCD\u3055\u3093 \u304C \u3069\u308C\u3060\u3051
    \u3044\u308B\u3068 \u601D\u3044\u307E\u3059\uFF1F\r\n\u6570\u5B57\u3092\u898B\u308C\u3070\u4E00\u76EE\u77AD\u7136\u3060\u306A\u3001\u6D88\u8CBB\u7A0E\u30BC\u30ED\u306B\u3057\u305F\u3089\u793E\u4F1A\u4FDD\u969C\u8CBB45\u5146\u5186\u306F\u3069\u3053\u304B\u3089\u6301\u3063\u3066\u304F\u308B\u3093\u3060\uFF1F\u6F2B\u753B\u306E\u4E16\u754C\u3058\u3083\u3042\u308B\u307E\u3044\u3057\u3001\u73FE\u5B9F\u3092\u898B\u3088\u3046\u3058\u3083\u306A\u3044\u304B\u3002\r\n\u30A2\u30DB\u304B\uFF01\u6D88\u8CBB\u7A0E\u306A\u3093\u3066\u98DF\u6599\u54C1\u3060\u3051\u30BC\u30ED\u306B\u3057\u305F\u3089\u3048\u3048\u3084\u308D\uFF01\u9EBB\u751F\u3055\u3093\u3001\u793E\u4F1A\u4FDD\u969C\u8CBB\u304C\u5FC3\u914D\u306A\u3089\u8B70\u54E1\u306E\u7D66\u6599\u534A\u5206\u306B\u30AB\u30C3\u30C8\u3057\u3066\u653F\u515A\u4EA4\u4ED8\u91D1\u3082\u524A\u308C\u3084\u3001\u65E5\u672C\u4EBA\u306A\u3081\u3093\u306A\u3088\uFF01\r\n\u79C1\u306F
    \u304B\u306D\u3066\u3088\u308A \u7533\u3057\u4E0A\u3052\u3066\u304A\u308A\u307E\u3059\u304C\u3001\u6D88\u8CBB\u7A0E
    \u306E \u8B70\u8AD6 \u306F \u56FD\u5BB6 \u767E\u5E74 \u306E \u8A08 \u3092 \u898B\u636E\u3048\u3066
    \u884C\u3046\u3079\u304D \u3067\u3059\uFF01\u77ED\u671F\u7684 \u306A \u4EBA\u6C17\u53D6\u308A
    \u3067\u306F \u306A\u304F\u3001\u6210\u9577 \u3068 \u5206\u914D \u306E \u597D\u5FAA\u74B0
    \u3067 \u7D4C\u6E08 \u3092 \u5F37\u304F\u3059\u308B \u3053\u3068 \u3053\u305D
